# ── Spring Profile ─────────────────────────────
# Options: dev | prod | docker
#   dev  = auto-create tables, debug logging
#   prod = validate only, warn logging
#   docker = used when app runs inside Docker Compose
# 
# For now, we keep `dev` – the app will work fine.
# If you want to separate Docker config later, you can create
# application-docker.yml and set this to `docker`.
SPRING_PROFILES_ACTIVE=dev

# ── Database ───────────────────────────────────
# Host and port for Postgres – use the Docker service name
DB_HOST=postgres           # container name of the Postgres service
DB_PORT=5432               # internal Postgres port (not the host port)

# Database name, user, and password
POSTGRES_DB=mystudyapp
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme-strong-password-here

# ── JWT (must be >= 32 characters) ─────────────
# Generate a strong random string for production.
# Example generation: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-256-bit-secret-key-min-32-chars!!

# ── App Ports ──────────────────────────────────
# These are used by the Spring Boot apps internally – we set them in the Dockerfile
# and they are also exposed on the host via docker-compose.
SERVER_PORT=8081
ASTA_SERVER_PORT=8082

# ── Frontend URL (for email links, CORS, etc.) ─
# In Docker, the frontend is served on port 80 (default) on the host.
# Adjust if you map to a different host port (e.g., 3000:80).
FRONTEND_URL=http://localhost

# ── Email From Address ─────────────────────────
MAIL_FROM=noreply@mystudyapp.de

# ── MQTT (Mosquitto broker) ────────────────────
# Use the Docker service name of the Mosquitto broker
MQTT_HOST=mosquitto

# ── Email (Gmail SMTP) ─────────────────────────
# Gmail account for sending emails (use App Password, not regular password)
# To generate an App Password:
# 1. Go to your Google Account → Security → 2-Step Verification
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to App Passwords (under 2-Step Verification)
# 4. Select "Mail" and your device, then generate
# 
# IMPORTANT: Replace these with your actual credentials.
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx